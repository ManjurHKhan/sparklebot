# Slack App (required)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-token

# Database (optional)
SPARKLE_DB_PATH=data/sparklebot.db

# Personalization (all optional, defaults shown)
SPARKLE_CURRENCY=sparkle
SPARKLE_CURRENCY_PLURAL=sparkles
SPARKLE_PERSONALITY=playful

# Party mode (all optional, defaults shown)
SPARKLE_PARTY_MINUTES=30
SPARKLE_PARTY_MAX_RECIPIENTS=10
SPARKLE_PARTY_CHANNEL_COOLDOWN_S=300
SPARKLE_PARTY_GIVER_COOLDOWN_S=1800

# Welcome new members (optional; needs the team_join bot event). Channel ID, empty = off.
SPARKLE_WELCOME_CHANNEL=
# Channel tour in the welcome DM: JSON array, up to 15 entries
# SPARKLE_WELCOME_CHANNELS=[{"id":"C0FAKE0002","about":"where the designers hang out"}]
SPARKLE_WELCOME_CHANNELS=
# Milestone burst: 1-23 :shortcodes:, empty = default
# SPARKLE_MEGA_EMOJI=:fireworks::sparkles::boom::sparkles::fireworks:
SPARKLE_MEGA_EMOJI=
# User ID that receives .suggest ideas by DM, empty = .suggest off
# SPARKLE_SUGGEST_TO=U0FAKE0001
SPARKLE_SUGGEST_TO=

# Rate limiting (all optional, defaults shown)
SPARKLE_RATE_LIMIT=10
SPARKLE_RATE_WINDOW_S=60

# Health probe (optional)
HEALTH_PORT=8080
