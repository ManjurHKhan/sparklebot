# Slack App (required)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-token

# Database (optional)
SPARKLE_DB_PATH=data/sparklebot.db

# Personalization (all optional, defaults shown)
SPARKLE_CURRENCY=sparkle
SPARKLE_CURRENCY_PLURAL=sparkles
SPARKLE_PERSONALITY=playful

# Party mode (all optional, defaults shown)
SPARKLE_PARTY_MINUTES=30
SPARKLE_PARTY_MAX_RECIPIENTS=10
SPARKLE_PARTY_CHANNEL_COOLDOWN_S=300
SPARKLE_PARTY_GIVER_COOLDOWN_S=1800

# Rate limiting (all optional, defaults shown)
SPARKLE_RATE_LIMIT=10
SPARKLE_RATE_WINDOW_S=60

# Health probe (optional)
HEALTH_PORT=8080
