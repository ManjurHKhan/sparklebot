{
  "name": "sparklebot",
  "version": "1.1.1",
  "type": "module",
  "description": "A lightweight Slack bot for peer recognition. Give your teammates sparkles for being awesome.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && cp -R src/personalities dist/personalities",
    "start": "node --env-file=.env dist/index.js",
    "dev": "npm run build && node --env-file=.env dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "keywords": [
    "slack",
    "bot",
    "recognition",
    "sparkles"
  ],
  "license": "MIT",
  "dependencies": {
    "@slack/bolt": "^4.7.3",
    "better-sqlite3": "^12.10.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.12.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
